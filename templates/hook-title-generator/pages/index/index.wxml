<view class="page">
  <view class="banner">当前钩子来自示例数据里预先写好的 hook_titles。以后可由 daily-ai-news 的大模型评分接口生成。</view>
  <view class="eyebrow">HOOKS</view>
  <view class="h1">标题钩子生成器</view>
  <view class="lead">先选一条新闻，再复制焦虑型或反转型钩子。</view>

  <view class="card {{currentId === item.id ? 'picked' : ''}}" wx:for="{{items}}" wx:key="id" bindtap="pick" data-id="{{item.id}}">
    <view class="title">{{item.title}}</view>
    <view class="meta">{{item.source}} · 吸睛 {{item.scores.hook}}</view>
  </view>

  <view class="card" wx:if="{{current}}">
    <view class="meta">{{current.summary}}</view>
    <view class="hook" wx:for="{{current.hooks}}" wx:key="text" bindtap="copy" data-text="{{item.text}}">
      <view class="chip {{item.type === 'anxiety' ? 'anxiety' : 'hook'}}">{{item.type === 'anxiety' ? '焦虑型' : '反转型'}}</view>
      <view class="title" style="margin-top: 12rpx;">{{item.text}}</view>
      <view class="meta">点按复制</view>
    </view>
  </view>
</view>
