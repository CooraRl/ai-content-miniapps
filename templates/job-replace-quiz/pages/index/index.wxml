<view class="page">
  <view class="eyebrow">CAREER CHECK</view>
  <view class="h1">AI 会不会取代我的职业？</view>
  <view class="lead">{{quiz.disclaimer}}</view>

  <block wx:if="{{!done}}">
    <view class="card">
      <view class="title">先选一个更接近你的方向</view>
      <view class="choices">
        <view class="choice {{jobId === item.id ? 'on' : ''}}" wx:for="{{quiz.jobs}}" wx:key="id" bindtap="pickJob" data-id="{{item.id}}">{{item.name}}</view>
      </view>
    </view>
    <view class="card" wx:for="{{quiz.questions}}" wx:key="id">
      <view class="title">{{item.text}}</view>
      <view class="choices">
        <view class="choice {{answers[item.id] === 1 ? 'on' : ''}}" bindtap="choose" data-qid="{{item.id}}" data-value="1">不太符合</view>
        <view class="choice {{answers[item.id] === 2 ? 'on' : ''}}" bindtap="choose" data-qid="{{item.id}}" data-value="2">有一半是</view>
        <view class="choice {{answers[item.id] === 3 ? 'on' : ''}}" bindtap="choose" data-qid="{{item.id}}" data-value="3">很符合</view>
      </view>
    </view>
    <view class="btn" bindtap="submit">查看风险等级</view>
  </block>

  <view class="card" wx:else>
    <view class="eyebrow">{{jobName}}</view>
    <view class="h1">{{level}} · {{score}} 分</view>
    <view class="meta">{{advice}}</view>
    <view class="meta" style="margin-top: 16rpx;">相关示例钩子：{{hook}}</view>
    <view class="btn ghost" bindtap="reset">换个方向再看</view>
  </view>
</view>
