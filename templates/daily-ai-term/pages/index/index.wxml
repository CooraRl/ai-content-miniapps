<view class="page">
  <view class="eyebrow">GLOSSARY</view>
  <view class="h1">每日一个 AI 名词</view>
  <view class="lead">按日期轮换。也可以左右切换，把概念做成短内容素材。</view>

  <view class="card term">
    <view class="meta">第 {{index + 1}} / {{total}} 个</view>
    <view class="h1">{{term.name}}</view>
    <view class="chip cat">{{term.name_zh}}</view>
    <view class="title" style="margin-top: 24rpx;">{{term.one_liner}}</view>
    <view class="meta" style="margin-top: 16rpx;">{{term.detail}}</view>
  </view>

  <view class="row" style="margin-top: 24rpx;">
    <view class="btn ghost" style="flex: 1; margin-top: 0;" bindtap="prev">上一个</view>
    <view class="btn" style="flex: 1; margin-top: 0;" bindtap="next">下一个</view>
  </view>
</view>
