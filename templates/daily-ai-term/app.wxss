/* 全库统一的视觉约定：深色背景、卡片、三种评分色。 */
page {
  --bg: #0b0f14;
  --card: #161c24;
  --card-2: #1c2430;
  --line: #2a3544;
  --text: #e8eef5;
  --muted: #8a97a8;
  --accent: #5b8cff;
  --hook: #ffb020;
  --anxiety: #ff6b4a;
  --good: #3ddc97;
  --radius: 20rpx;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif;
  min-height: 100%;
  font-size: 28rpx;
  line-height: 1.55;
}

.page {
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: var(--accent);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.h1 {
  font-size: 44rpx;
  font-weight: 650;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.lead,
.hint {
  color: var(--muted);
  font-size: 24rpx;
}

.hint { margin-top: 16rpx; }

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-top: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.meta {
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--card-2);
  color: var(--muted);
}

.chip.hook { color: var(--hook); background: rgba(255, 176, 32, 0.12); }
.chip.anxiety { color: var(--anxiety); background: rgba(255, 107, 74, 0.12); }
.chip.relevance { color: var(--good); background: rgba(61, 220, 151, 0.12); }
.chip.cat { color: var(--accent); background: rgba(91, 140, 255, 0.12); }

.btn {
  margin-top: 20rpx;
  background: var(--accent);
  color: #081018;
  text-align: center;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-weight: 600;
}

.btn.ghost {
  background: transparent;
  color: var(--text);
  border: 1rpx solid var(--line);
}

.banner {
  background: rgba(91, 140, 255, 0.1);
  border: 1rpx solid rgba(91, 140, 255, 0.25);
  color: var(--muted);
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.score-bar {
  height: 10rpx;
  background: var(--card-2);
  border-radius: 999rpx;
  overflow: hidden;
  margin-top: 8rpx;
}

.score-bar > view {
  height: 100%;
  border-radius: 999rpx;
}
