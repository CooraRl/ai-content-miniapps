<view class="page">
  <view class="eyebrow">SELF CHECK</view>
  <view class="h1">AI 焦虑指数</view>
  <view class="lead">{{quiz.disclaimer}}</view>

  <block wx:if="{{!done}}">
    <view class="card" wx:for="{{quiz.questions}}" wx:key="id">
      <view class="title">{{index + 1}}. {{item.text}}</view>
      <view class="choices">
        <view
          wx:for="{{quiz.choices}}"
          wx:for-item="choice"
          wx:key="value"
          class="choice {{answers[item.id] === choice.value ? 'on' : ''}}"
          bindtap="choose"
          data-qid="{{item.id}}"
          data-value="{{choice.value}}"
        >{{choice.label}}</view>
      </view>
    </view>
    <view class="btn" bindtap="submit">查看指数</view>
  </block>

  <view class="card" wx:else>
    <view class="eyebrow">你的指数</view>
    <view class="h1">{{score}} / 100 · {{level}}</view>
    <view class="score-bar"><view style="width: {{score}}%; background: {{color}};"></view></view>
    <view class="meta" style="margin-top: 20rpx;">{{advice}}</view>
    <view class="meta" wx:if="{{related.length}}">相关示例选题：{{related}}</view>
    <view class="btn ghost" bindtap="reset">再测一次</view>
  </view>
</view>
