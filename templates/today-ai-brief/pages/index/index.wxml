<view class="page">
  <view class="banner">当前展示的是本地示例数据，不是真实新闻。以后可切换到 daily-ai-news 的 FastAPI。</view>
  <view class="eyebrow">DAILY BRIEF</view>
  <view class="h1">今日 AI 快讯</view>
  <view class="lead">{{generatedAt}} · {{itemCount}} 条示例 · {{timezone}}</view>

  <view class="card" wx:for="{{items}}" wx:key="id" bindtap="toggle" data-id="{{item.id}}">
    <view class="title">{{item.title}}</view>
    <view class="meta">{{item.source}} · {{item.published}}</view>
    <view class="chips">
      <text class="chip cat">{{item.category}}</text>
      <text class="chip hook">吸睛 {{item.scores.hook}}</text>
      <text class="chip anxiety">焦虑 {{item.scores.anxiety}}</text>
      <text class="chip relevance">相关 {{item.scores.relevance}}</text>
    </view>
    <view wx:if="{{item.open}}">
      <view class="meta" style="margin-top: 16rpx;">{{item.summary}}</view>
      <view class="meta">钩子：{{item.hook_titles[0]}}</view>
    </view>
  </view>
</view>
